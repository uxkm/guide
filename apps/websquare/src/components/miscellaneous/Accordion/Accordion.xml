<!-- Accordion WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="accordionExample" class="accordion">
  <xf:trigger id="accordionExampleTrigger" class="accordion_trigger">
    <xf:label><![CDATA[Accordion 열기]]></xf:label>
  </xf:trigger>
  <w2:group id="accordionExampleBody" class="accordion_body">
    <w2:textbox id="accordionExampleContent" class="accordion_content" label="Accordion 콘텐츠"></w2:textbox>
  </w2:group>
</w2:group>
