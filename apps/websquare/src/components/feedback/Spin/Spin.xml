<!-- Spin WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="spinExample" class="spin" role="status">
  <w2:textbox id="spinExampleMessage" class="spin_message" label="Spin 메시지"></w2:textbox>
  <xf:trigger id="spinExampleClose" class="spin_close">
    <xf:label><![CDATA[닫기]]></xf:label>
  </xf:trigger>
</w2:group>
