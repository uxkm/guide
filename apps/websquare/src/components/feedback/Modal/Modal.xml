<!-- Modal WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="modalExample" class="modal" role="status">
  <w2:textbox id="modalExampleMessage" class="modal_message" label="Modal 메시지"></w2:textbox>
  <xf:trigger id="modalExampleClose" class="modal_close">
    <xf:label><![CDATA[닫기]]></xf:label>
  </xf:trigger>
</w2:group>
