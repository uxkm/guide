<!-- Skeleton WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="skeletonExample" class="skeleton" role="status">
  <w2:textbox id="skeletonExampleMessage" class="skeleton_message" label="Skeleton 메시지"></w2:textbox>
  <xf:trigger id="skeletonExampleClose" class="skeleton_close">
    <xf:label><![CDATA[닫기]]></xf:label>
  </xf:trigger>
</w2:group>
