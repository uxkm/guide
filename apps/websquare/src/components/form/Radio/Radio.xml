<!-- Radio WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="radioExampleField" class="form_field">
  <w2:textbox id="radioExampleLabel" tagname="label" class="form_field-label" label="Radio"></w2:textbox>
  <xf:select1 id="radioExample" class="radio" appearance="full"></xf:select1>
  <w2:textbox id="radioExampleHint" class="form_field-hint" label="도움말"></w2:textbox>
</w2:group>
