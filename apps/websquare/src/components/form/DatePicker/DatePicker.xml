<!-- DatePicker WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="datePickerExampleField" class="form_field">
  <w2:textbox id="datePickerExampleLabel" tagname="label" class="form_field-label" label="DatePicker"></w2:textbox>
  <w2:inputCalendar id="datePickerExample" class="date_picker"></w2:inputCalendar>
  <w2:textbox id="datePickerExampleHint" class="form_field-hint" label="도움말"></w2:textbox>
</w2:group>
