<!-- Upload WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="uploadExampleField" class="form_field">
  <w2:textbox id="uploadExampleLabel" tagname="label" class="form_field-label" label="Upload"></w2:textbox>
  <xf:input id="uploadExample" class="upload" type="file"></xf:input>
  <w2:textbox id="uploadExampleHint" class="form_field-hint" label="도움말"></w2:textbox>
</w2:group>
