<!-- Slider WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="sliderExampleField" class="form_field">
  <w2:textbox id="sliderExampleLabel" tagname="label" class="form_field-label" label="Slider"></w2:textbox>
  <xf:input id="sliderExample" class="slider" type="range"></xf:input>
  <w2:textbox id="sliderExampleHint" class="form_field-hint" label="도움말"></w2:textbox>
</w2:group>
