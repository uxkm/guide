<!-- FormLayout WebSquare fragment: 화면 XML 루트의 w2, xf, ev namespace를 상속합니다. -->
<w2:group id="formLayoutExample" tagname="form" class="form form_vertical">
  <w2:group id="formFieldExample" class="form_field">
    <w2:textbox id="formLabelExample" tagname="label" class="form_field-label" label="이름"></w2:textbox>
    <xf:input id="formInputExample" class="input"></xf:input>
  </w2:group>
  <xf:trigger id="formSubmitExample" class="btn btn_filled color_primary">
    <xf:label><![CDATA[저장]]></xf:label>
  </xf:trigger>
</w2:group>
