---
import BaseLayout from '../layouts/BaseLayout.astro';
import SaveButton from '../components/SaveButton.jsx';
---

<BaseLayout>
  <main class="guide_content">
    <div class="container container_lg">
      <header class="page_intro">
        <p class="color_accent size_sm">React · Astro</p>
        <h1>UXKM Astro</h1>
        <p class="lead">React 컴포넌트를 Astro island로 사용하는 통합 예제를 확인합니다.</p>
      </header>
      <section class="section" aria-labelledby="astro-start-title">
        <h2 id="astro-start-title">개발 서버가 정상적으로 실행되었습니다</h2>
        <div class="card_grid">
          <article class="category_card">
            <h3>실행 명령</h3>
            <p><code class="typo_code">pnpm dev:astro</code></p>
            <span class="count">Port 6113</span>
          </article>
          <article class="category_card">
            <h3>구현 기준</h3>
            <p>React · Astro Islands</p>
            <span class="count">@uxkm/astro</span>
          </article>
          <a class="category_card" href="http://localhost:6006">
            <h3>Storybook</h3>
            <p>전체 컴포넌트 문서와 예제를 확인합니다.</p>
            <span class="count">문서 열기 →</span>
          </a>
        </div>
      </section>
      <section class="section" aria-labelledby="astro-island-title">
        <h2 id="astro-island-title">React Island 예제</h2>
        <SaveButton client:load />
      </section>
    </div>
  </main>
</BaseLayout>
