{% extends "templates/layouts/default.njk" %}
{% from "templates/partials/component-demo.njk" import componentDemo %}
{% from "components/miscellaneous/Accordion/accordion.njk" import accordion, accordionItem %}
{% from "components/miscellaneous/Collapse/collapse.njk" import collapse, collapsePanel %}
{% from "components/miscellaneous/Affix/affix.njk" import affix %}
{% from "components/miscellaneous/BackTop/back-top.njk" import backTop %}
{% from "components/miscellaneous/Carousel/carousel.njk" import carousel, carouselSlide %}
{% from "components/basic/Button/button.njk" import button %}

{% set title = "UXKM Gulp · Miscellaneous" %}

{% block content %}
<main class="guide_content">
  <div class="container container_lg">
    <header class="page_intro">
      <p class="color_accent size_sm"><a class="link color_accent" href="/components.html">컴포넌트</a> · Miscellaneous</p>
      <h1>Miscellaneous</h1>
      <p class="lead">Miscellaneous 컴포넌트는 호출형 매크로와 공통 기본 컴포넌트로 렌더합니다.</p>
    </header>

    {% call componentDemo('Accordion', 'components/miscellaneous/Accordion/accordion.njk', 'accordion') %}
      {% call accordion(id='demo-accordion', variant='card') %}
        {% call accordionItem(id='demo-accordion-1', label='배송은 얼마나 걸리나요?') %}평일 기준 2~3일 이내 출고됩니다.{% endcall %}
        {% call accordionItem(id='demo-accordion-2', label='교환·반품은 어떻게 하나요?', open=true) %}수령 후 7일 이내 신청할 수 있습니다.{% endcall %}
        {% call accordionItem(id='demo-accordion-3', label='해외 배송이 가능한가요?') %}현재 국내 배송만 지원합니다.{% endcall %}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Collapse', 'components/miscellaneous/Collapse/collapse.njk', 'collapse') %}
      {% call collapse(id='demo-collapse') %}
        {% call collapsePanel(id='demo-collapse-1', label='배송 정보', open=true) %}평일 기준 2~3일 이내 출고됩니다.{% endcall %}
        {% call collapsePanel(id='demo-collapse-2', label='결제 수단') %}신용카드, 계좌이체, 간편결제를 지원합니다.{% endcall %}
        {% call collapsePanel(id='demo-collapse-3', label='교환·반품 안내') %}수령 후 7일 이내 신청할 수 있습니다.{% endcall %}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Carousel', 'components/miscellaneous/Carousel/carousel.njk', 'carousel') %}
      {% call carousel(id='demo-carousel') %}
        {{ carouselSlide(overline='이벤트', title='신규 가입 혜택', content='첫 주문 20% 할인 쿠폰을 드립니다.', color='primary') }}
        {{ carouselSlide(overline='혜택', title='무료 배송', content='3만 원 이상 구매 시 무료 배송됩니다.', color='success') }}
        {{ carouselSlide(overline='세일', title='시즌 세일', content='베스트셀러 상품을 최대 50% 할인합니다.', color='warning') }}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Affix', 'components/miscellaneous/Affix/affix.njk', 'affix') %}
      {% call affix(skin='bar', interactive=false) %}
        <span class="affix_bar-label">고정 작업</span>
        <div class="affix_bar-actions">{{ button(size='sm', label='확인') }}</div>
      {% endcall %}
    {% endcall %}

    {% call componentDemo('BackTop', 'components/miscellaneous/BackTop/back-top.njk', 'back-top') %}
      {{ backTop(color='primary', label='TOP', interactive=false) }}
    {% endcall %}

    <p><a class="link color_primary" href="/components.html">← 컴포넌트 목록</a></p>
  </div>
</main>
{% endblock %}
