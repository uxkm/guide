{% extends "templates/layouts/default.njk" %}
{% from "templates/partials/component-demo.njk" import componentDemo %}
{% from "components/navigation/Navbar/navbar.njk" import navbar, navbarList, navbarItem %}
{% from "components/navigation/Menu/menu.njk" import menu, menuItem %}
{% from "components/navigation/Breadcrumb/breadcrumb.njk" import breadcrumb, breadcrumbItem %}
{% from "components/navigation/Tabs/tabs.njk" import tabs, tab, tabPanel %}
{% from "components/navigation/Pagination/pagination.njk" import pagination %}
{% from "components/navigation/Dropdown/dropdown.njk" import dropdown %}
{% from "components/navigation/Steps/steps.njk" import steps, step %}

{% set title = "UXKM Gulp · Navigation" %}

{% block content %}
<main class="guide_content">
  <div class="container container_lg">
    <header class="page_intro">
      <p class="color_accent size_sm"><a class="link color_accent" href="/components.html">컴포넌트</a> · Navigation</p>
      <h1>Navigation</h1>
      <p class="lead">Navigation 컴포넌트는 호출형 매크로와 공통 기본 컴포넌트로 렌더합니다.</p>
    </header>

    {% call componentDemo('Breadcrumb', 'components/navigation/Breadcrumb/breadcrumb.njk', 'breadcrumb') %}
      {% call breadcrumb(ariaLabel='Navigation 경로') %}
        {{ breadcrumbItem(label='홈', href='/') }}
        {{ breadcrumbItem(label='컴포넌트', href='/components.html') }}
        {{ breadcrumbItem(label='Navigation', current=true) }}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Navbar', 'components/navigation/Navbar/navbar.njk', 'navbar') %}
      {% set navbarItems %}
        {% call navbarList() %}
          {{ navbarItem(label='개요', active=true) }}
          {{ navbarItem(label='가이드') }}
          {{ navbarItem(label='컴포넌트') }}
        {% endcall %}
      {% endset %}
      {{ navbar(brand='UXKM', items=navbarItems) }}
    {% endcall %}

    {% call componentDemo('Menu', 'components/navigation/Menu/menu.njk', 'menu') %}
      {% call menu(bordered=true, ariaLabel='주요 메뉴') %}
        {{ menuItem(label='대시보드', active=true) }}
        {{ menuItem(label='프로젝트') }}
        {{ menuItem(label='설정') }}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Dropdown', 'components/navigation/Dropdown/dropdown.njk', 'dropdown') %}
      {% call dropdown(triggerLabel='옵션', open=true) %}
        {% call menu(compact=true, ariaLabel='옵션 메뉴') %}
          {{ menuItem(label='편집') }}
          {{ menuItem(label='복제') }}
          {{ menuItem(label='삭제') }}
        {% endcall %}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Tabs', 'components/navigation/Tabs/tabs.njk', 'tabs') %}
      {% set tabItems %}
        {{ tab(id='demo-tab-1', panelId='demo-panel-1', label='일반', active=true) }}
        {{ tab(id='demo-tab-2', panelId='demo-panel-2', label='상세') }}
        {{ tab(id='demo-tab-3', panelId='demo-panel-3', label='설정') }}
      {% endset %}
      {% set tabPanels %}
        {% call tabPanel(id='demo-panel-1', tabId='demo-tab-1', active=true) %}일반 탭 패널입니다.{% endcall %}
        {% call tabPanel(id='demo-panel-2', tabId='demo-tab-2') %}상세 탭 패널입니다.{% endcall %}
        {% call tabPanel(id='demo-panel-3', tabId='demo-tab-3') %}설정 탭 패널입니다.{% endcall %}
      {% endset %}
      {{ tabs(tabs=tabItems, panels=tabPanels, ariaLabel='설정 탭') }}
    {% endcall %}

    {% call componentDemo('Steps', 'components/navigation/Steps/steps.njk', 'steps') %}
      {% call steps(ariaLabel='계정 설정 단계') %}
        {{ step(title='계정', description='기본 정보', status='finished', index=1) }}
        {{ step(title='프로필', description='추가 정보', status='active', index=2) }}
        {{ step(title='완료', description='확인', status='wait', index=3, last=true) }}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Pagination', 'components/navigation/Pagination/pagination.njk', 'pagination') %}
      {{ pagination(current=2, total=50, pageSize=10) }}
    {% endcall %}

    <p><a class="link color_primary" href="/components.html">← 컴포넌트 목록</a></p>
  </div>
</main>
{% endblock %}
