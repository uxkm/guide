{% extends "templates/layouts/default.njk" %}
{% from "templates/partials/component-demo.njk" import componentDemo %}
{% from "components/layout/Grid/grid.njk" import grid, gridCol %}
{% from "components/layout/Flex/flex.njk" import flex, flexItem %}
{% from "components/layout/Divider/divider.njk" import divider %}
{% from "components/layout/Space/space.njk" import space %}

{% set title = "UXKM Gulp · Layout" %}

{% block content %}
<main class="guide_content">
  <div class="container container_lg">
    <header class="page_intro">
      <p class="color_accent size_sm"><a class="link color_accent" href="/components.html">컴포넌트</a> · Layout</p>
      <h1>Layout</h1>
      <p class="lead">레이아웃 컴포넌트를 include로 렌더합니다.</p>
    </header>

    {% call componentDemo('Container', 'components/layout/Container/container.njk', 'container') %}
      {% include "components/layout/Container/container.njk" %}

      <div class="container_demo-sizes">
        {% set items = [
          { size: 'sm', label: 'Small · 36rem' },
          { size: 'md', label: 'Medium · 48rem' },
          { size: 'lg', label: 'Large · 64rem' },
          { size: 'xl', label: 'Extra Large · 80rem' }
        ] %}
        {% for item in items %}
          {% set size = item.size %}
          {% set content %}
            <div class="container_demo-fill">{{ item.label }}</div>
          {% endset %}
          {% include "components/layout/Container/container.njk" %}
        {% endfor %}
      </div>
    {% endcall %}

    {% call componentDemo('Divider', 'components/layout/Divider/divider.njk', 'divider') %}
      {{ divider() }}
      {{ divider(dashed=true) }}
      {{ divider(marginY='sm') }}
      {{ divider(thickness='lg') }}
      {{ divider(label='섹션 제목') }}
      {{ divider(plain=true, orient='left', label='왼쪽 보조 설명') }}
      {% call space() %}
        <span>항목 A</span>
        {{ divider(vertical=true, marginY='lg', height='md') }}
        <span>항목 B</span>
        {{ divider(vertical=true, dashed=true, height='lg') }}
        <span>항목 C</span>
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Flex', 'components/layout/Flex/flex.njk', 'flex') %}
      {% call flex(cols=3, gap='sm') %}
        {% for n in [1, 2, 3] %}
          <div class="flex_demo-cell">{{ n }}</div>
        {% endfor %}
      {% endcall %}

      {% call flex(wrap=true, gap='sm') %}
        {% call flexItem(as='header', span=12, className='flex_demo-cell') %}Header{% endcall %}
        {% call flexItem(as='aside', span=12, spanMd=3, className='flex_demo-cell') %}Sidebar{% endcall %}
        {% call flexItem(as='main', span=12, spanMd=9, className='flex_demo-cell') %}Main content{% endcall %}
        {% call flexItem(as='footer', span=12, className='flex_demo-cell') %}Footer{% endcall %}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Grid', 'components/layout/Grid/grid.njk', 'grid') %}
      {% call grid(cols=3, gap='sm') %}
        {% for n in [1, 2, 3] %}
          <div class="grid_demo-cell">{{ n }}</div>
        {% endfor %}
      {% endcall %}

      {% call grid(gap='sm') %}
        {% call gridCol(as='header', span=12, className='grid_demo-cell') %}Header{% endcall %}
        {% call gridCol(as='aside', span=12, spanMd=3, className='grid_demo-cell') %}Sidebar{% endcall %}
        {% call gridCol(as='main', span=12, spanMd=9, className='grid_demo-cell') %}Main content{% endcall %}
        {% call gridCol(as='footer', span=12, className='grid_demo-cell') %}Footer{% endcall %}
      {% endcall %}
    {% endcall %}

    {% call componentDemo('Space', 'components/layout/Space/space.njk', 'space') %}
      {% call space() %}
        <div class="space_demo-box">항목 1</div>
        <div class="space_demo-box">항목 2</div>
        <div class="space_demo-box">항목 3</div>
      {% endcall %}

      {% call space(vertical=true, align='stretch', gap='sm') %}
        <div class="space_demo-box">첫 번째</div>
        <div class="space_demo-box">두 번째</div>
        <div class="space_demo-box">세 번째</div>
      {% endcall %}

      {% call space(block=true, wrap=true, justify='between') %}
        <div class="space_demo-box">시작</div>
        <div class="space_demo-box">끝</div>
      {% endcall %}
    {% endcall %}

    <p><a class="link color_primary" href="/components.html">← 컴포넌트 목록</a></p>
  </div>
</main>
{% endblock %}
