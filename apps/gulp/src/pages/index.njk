{% extends "templates/layouts/default.njk" %}

{% set title = "UXKM Gulp / Nunjucks" %}

{% block content %}
<main class="guide_content">
  <div class="container container_lg">
    <header class="page_intro"><p class="color_accent size_sm">Gulp · Nunjucks</p><h1>UXKM Gulp / Nunjucks</h1><p class="lead">정적 템플릿 기반 UXKM 컴포넌트 가이드의 실행 화면입니다.</p></header>
    <section class="section" aria-labelledby="gulp-start-title">
