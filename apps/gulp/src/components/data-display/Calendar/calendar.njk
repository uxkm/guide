{# Calendar는 HTML과 동일한 OOCSS 예시를 Nunjucks 데이터로 반복 구성할 수 있습니다. #}
{% set weekdays = ['일', '월', '화', '수', '목', '금', '토'] %}

{# Calendar · 기본 #}
<div class="calendar" role="application" aria-label="2024년 6월">
  <div class="calendar_header"><button class="btn btn_ghost btn_icon-only btn_sm" type="button" aria-label="이전 달">‹</button><span class="calendar_title">2024년 6월</span><button class="btn btn_ghost btn_icon-only btn_sm" type="button" aria-label="다음 달">›</button></div>
  <div class="calendar_weekdays" aria-hidden="true">{% for label in weekdays %}<span class="calendar_weekday">{{ label }}</span>{% endfor %}</div>
  <div class="calendar_grid">{% for day in range(1, 31) %}<button class="calendar_day{% if day == 12 %} is-today{% endif %}{% if day == 15 %} is-selected{% endif %}" type="button">{{ day }}</button>{% endfor %}</div>
</div>

{# Calendar · 헤더 없음 #}
<div class="calendar calendar_no-header" role="application" aria-label="2024년 6월"><div class="calendar_weekdays" aria-hidden="true">{% for label in weekdays %}<span class="calendar_weekday">{{ label }}</span>{% endfor %}</div><div class="calendar_grid"><button class="calendar_day">1</button><button class="calendar_day is-selected">15</button></div></div>

{# Calendar · 날짜만 #}
<div class="calendar calendar_minimal calendar_compact calendar_borderless" role="application" aria-label="2024년 6월 날짜만"><div class="calendar_grid"><button class="calendar_day">1</button><button class="calendar_day is-today">12</button><button class="calendar_day is-selected">15</button></div></div>

{# Calendar · 주간 #}
<div class="calendar calendar_week calendar_shadow" role="application" aria-label="6월 9일~15일"><div class="calendar_nav"><button type="button" aria-label="이전 주">‹</button><span class="calendar_nav-label">6월 9일 ~ 15일</span><button type="button" aria-label="다음 주">›</button></div><div class="calendar_grid calendar_grid-week">{% for day in range(9, 16) %}<button class="calendar_day">{{ day }}</button>{% endfor %}</div></div>

{# Calendar · 휠 #}
<div class="calendar calendar_wheel calendar_shadow" role="group" aria-label="날짜 휠 선택"><div class="calendar_wheel-toolbar"><button type="button">취소</button><span class="calendar_wheel-title">날짜 선택</span><button type="button">완료</button></div><div class="calendar_wheel-body"><div class="calendar_wheel-highlight"></div><div class="calendar_wheel-columns">{% for item in ['2024년', '6월', '15일'] %}<div class="calendar_wheel-column"><ul class="calendar_wheel-list" role="listbox"><li><button class="calendar_wheel-item is-selected" aria-selected="true">{{ item }}</button></li></ul></div>{% endfor %}</div></div></div>

{# Calendar · 범위 선택 #}
<div class="calendar" aria-label="범위 선택"><div class="calendar_grid"><button class="calendar_day is-selected is-range-start">10</button>{% for day in range(11, 18) %}<button class="calendar_day is-in-range">{{ day }}</button>{% endfor %}<button class="calendar_day is-selected is-range-end">18</button></div></div>

{# Calendar · 이벤트 마커 #}
<div class="calendar calendar_weekends" aria-label="이벤트"><div class="calendar_grid"><button class="calendar_day has-event">3</button><button class="calendar_day is-today has-event">12</button><button class="calendar_day is-selected has-event">15</button></div></div>

{# Calendar · 스킨 #}
<div class="calendar_group">{% for skin in ['borderless', 'ghost', 'shadow'] %}<div class="calendar calendar_{{ skin }}" aria-label="{{ skin }}"><div class="calendar_grid"><button class="calendar_day">8</button></div></div>{% endfor %}</div>

{# Calendar · 크기 #}
<div class="calendar_group">{% for size in ['sm', 'compact', 'lg'] %}<div class="calendar calendar_{{ size }}" aria-label="{{ size }}"><div class="calendar_grid"><button class="calendar_day">7</button></div></div>{% endfor %}</div>

{# Calendar · 푸터 #}
<div class="calendar calendar_shadow" aria-label="푸터 포함"><div class="calendar_grid"><button class="calendar_day is-selected">15</button></div><div class="calendar_footer"><button type="button">오늘</button><div class="calendar_footer-actions"><button type="button">초기화</button><button type="button">확인</button></div></div></div>

{# Calendar · 이중 패널 #}
<div class="calendar_group">{% for month in ['6월', '7월'] %}<div class="calendar calendar_compact calendar_shadow" aria-label="2024년 {{ month }}"><div class="calendar_header"><span class="calendar_title">2024년 {{ month }}</span></div><div class="calendar_grid"><button class="calendar_day is-selected">15</button></div></div>{% endfor %}</div>

{# Calendar · 세로 일정 #}
<div class="calendar calendar_agenda calendar_shadow" role="feed" aria-label="2024년 6월 일정"><div class="calendar_header"><span class="calendar_title">6월 14일 ~ 20일</span></div><ol class="calendar_agenda-list"><li class="calendar_agenda-day is-today"><div class="calendar_agenda-date"><span class="calendar_agenda-weekday">토</span><span class="calendar_agenda-daynum">15</span></div><div class="calendar_agenda-body"><ul class="calendar_agenda-events"><li class="calendar_agenda-event color_primary"><span class="calendar_agenda-event-time">09:00</span><span class="calendar_agenda-event-title">팀 스탠드업</span></li></ul></div></li></ol></div>

{# Calendar · 상태 #}
<div class="calendar_group"><div class="calendar calendar_readonly" aria-label="읽기 전용"><div class="calendar_grid"><button class="calendar_day is-selected" tabindex="-1">9</button></div></div><div class="calendar is-disabled" aria-label="비활성" aria-disabled="true"><div class="calendar_grid"><button class="calendar_day is-disabled" disabled>9</button></div></div></div>
