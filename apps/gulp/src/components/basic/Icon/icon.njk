{% macro icon(name = 'search', className = '') %}
<svg class="icon{% if className %} {{ className }}{% endif %}" data-component="Icon" data-icon="{{ name }}" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {% if name == 'close' %}
  <path d="m6 6 12 12M18 6 6 18"></path>
  {% else %}
  <circle cx="11" cy="11" r="8"></circle>
  <path d="m21 21-4.35-4.35"></path>
  {% endif %}
</svg>
{% endmacro %}

{{ icon(iconName | default('search'), iconClass | default('')) }}
