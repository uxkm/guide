{% macro icon(name = 'search', className = '') %}
<svg class="icon{% if className %} {{ className }}{% endif %}" data-component="Icon" data-icon="{{ name }}" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {% if name == 'close' %}
  <path d="m6 6 12 12M18 6 6 18"></path>
  {% elif name == 'inbox' %}
  <path d="M4 5h16l2 9v5H2v-5l2-9ZM2 14h5l2 3h6l2-3h5"></path>
  {% elif name == 'menu' %}
  <path d="M4 6h16M4 12h16M4 18h16"></path>
  {% elif name == 'chevron-down' %}
  <path d="m6 9 6 6 6-6"></path>
  {% elif name == 'chevron' %}
  <path d="m9 6 6 6-6 6"></path>
  {% elif name == 'chevron-right' %}
  <path d="m9 6 6 6-6 6"></path>
  {% elif name == 'chevron-left' %}
  <path d="m15 6-6 6 6 6"></path>
  {% elif name == 'arrow-left' %}
  <path d="M19 12H5m7 7-7-7 7-7"></path>
  {% elif name == 'home' %}
  <path d="m3 11 9-8 9 8M5 10v11h14V10M10 21v-7h4v7"></path>
  {% else %}
  <circle cx="11" cy="11" r="8"></circle>
  <path d="m21 21-4.35-4.35"></path>
  {% endif %}
</svg>
{% endmacro %}

{{ icon(iconName | default('search'), iconClass | default('')) }}
