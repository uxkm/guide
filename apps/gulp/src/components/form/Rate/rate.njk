{# Rate 원본 구현: 편집·읽기 전용 별점과 폼 필드를 macro로 구성합니다. #}
{% macro starGraphic(half = false) %}
<span class="rate_star-graphic" aria-hidden="true">
  <svg class="rate_star-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
  <svg class="rate_star-icon rate_star-icon-filled" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
  {% if half %}<span class="rate_star-icon-half"><svg class="rate_star-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg></span>{% endif %}
</span>
{% endmacro %}

{% macro rate(value = '', count = 5, allowHalf = false, clearable = false, readOnly = false, disabled = false, size = 'md', legend = '', name = 'rate-example', color = '', ripple = true, ariaLabel = '', className = '') %}
{% set resolvedCount = count if count > 0 else 5 %}
{% set resolvedSize = size if size in ['sm', 'md', 'lg'] else 'md' %}
{% set classes = 'rate' + ((' rate_' + resolvedSize) if resolvedSize != 'md' else '') + (' rate_allow-half' if allowHalf else '') + (' rate_clearable' if clearable else '') + (' is-readonly' if readOnly else '') + ((' color_' + color) if color else '') + ((' ' + className) if className else '') %}
{% if readOnly %}
<div class="{{ classes }}" data-component="Rate" role="img" aria-label="{{ ariaLabel if ariaLabel else (resolvedCount + '점 만점 중 ' + (value if value != '' else 0) + '점') }}">
  <div class="rate_stars">
    {% for star in range(1, resolvedCount + 1) %}
      {% set state = 'is-filled' if value >= star else ('is-half' if allowHalf and value >= star - 0.5 else '') %}
      <span class="rate_star-readonly{{ (' ' + state) if state else '' }}">{{ starGraphic(state == 'is-half') }}</span>
    {% endfor %}
  </div>
  {% if value != '' %}<span class="rate_value">{{ value }}</span>{% endif %}
</div>
{% else %}
<fieldset class="{{ classes }}" data-component="Rate"{% if ripple %} data-ripple="true"{% endif %}{% if disabled %} disabled{% endif %}{% if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}>
  {% if legend %}<legend class="rate_legend">{{ legend }}</legend>{% endif %}
  <div class="rate_control">
    <div class="rate_stars">
      {% for star in range(1, resolvedCount + 1) %}
      <label class="rate_star"{% if ripple %} data-ripple="true"{% endif %}>
        {% if allowHalf %}<input class="rate_input rate_input-half" type="radio" name="{{ name }}" value="{{ star - 0.5 }}"{% if value == star - 0.5 %} checked{% endif %}{% if disabled %} disabled{% endif %}><button type="button" class="rate_star-half rate_star-half-left" tabindex="-1" aria-hidden="true"{% if disabled %} disabled{% endif %}></button>{% endif %}
        <input class="rate_input" type="radio" name="{{ name }}" value="{{ star }}"{% if value == star %} checked{% endif %}{% if disabled %} disabled{% endif %}>
        {% if allowHalf %}<button type="button" class="rate_star-half rate_star-half-right" tabindex="-1" aria-hidden="true"{% if disabled %} disabled{% endif %}></button>{% endif %}
        {{ starGraphic(allowHalf) }}
        <span class="rate_star-label">{{ star }}점</span>
      </label>
      {% endfor %}
    </div>
    {% if clearable %}<button class="rate_clear" type="button"{% if ripple %} data-ripple="true"{% endif %} aria-label="별점 초기화" title="초기화">×</button>{% endif %}
    {% if value != '' %}<output class="rate_value">{{ value }}점</output>{% endif %}
  </div>
</fieldset>
{% endif %}
{% endmacro %}

{% macro rateField(label = '', labelId = '', hint = '', errorMessage = '', required = false, className = '') %}
<div class="form_field{{ (' ' + className) if className else '' }}">
  {% if label %}<span class="form_field-label"{% if labelId %} id="{{ labelId }}"{% endif %}>{{ label }}{% if required %}<span class="form_field-required"><span aria-hidden="true">*</span><span class="form_field-required-text">필수 항목</span></span>{% endif %}</span>{% endif %}
  {% if caller %}{{ caller() | safe }}{% endif %}
  {% if errorMessage %}<p class="form_field-error" role="alert">{{ errorMessage }}</p>{% elif hint %}<p class="form_field-hint">{{ hint }}</p>{% endif %}
</div>
{% endmacro %}

