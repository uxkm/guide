{# Input 원본 구현: 입력, 애드온, 지우기 액션과 필드 메시지를 Input 계열 macro로 구성합니다. #}
{% import "components/basic/Button/button.njk" as Button %}

{% macro input(
  id = '',
  name = '',
  type = 'text',
  size = 'md',
  placeholder = '',
  value = '',
  disabled = false,
  readonly = false,
  required = false,
  error = false,
  success = false,
  block = false,
  clearable = false,
  prefix = '',
  suffix = '',
  inputMode = '',
  maxLength = '',
  ariaLabel = '',
  ariaDescribedby = '',
  className = '',
  fit = false
) %}
{%- set inputClasses =
  'input'
  + (' input_sm' if size == 'sm' else '')
  + (' input_lg' if size == 'lg' else '')
  + (' input_block' if block else '')
  + (' input_masked' if type == 'password' and value else '')
  + (' is-error' if error else '')
  + (' is-success' if success else '')
  + ((' ' + className) if className and not prefix and not suffix and not clearable else '')
-%}
{%- set wrapperClass =
  (className if className and (prefix or suffix or clearable) else '')
  + (' input_fit' if fit else '')
-%}
{%- set isFilled = value and not disabled and not readonly -%}
{%- set control %}
<input
  {% if id %}id="{{ id }}"{% endif %}
  {% if name %}name="{{ name }}"{% endif %}
  class="{{ inputClasses }}"
  type="{{ type }}"
  {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
  {% if value != '' %}value="{{ value }}"{% endif %}
  {% if inputMode %}inputmode="{{ inputMode }}"{% endif %}
  {% if maxLength %}maxlength="{{ maxLength }}"{% endif %}
  {% if disabled %}disabled{% endif %}
  {% if readonly %}readonly{% endif %}
  {% if required %}required aria-required="true"{% endif %}
  {% if error %}aria-invalid="true"{% endif %}
  {% if ariaLabel %}aria-label="{{ ariaLabel }}"{% endif %}
  {% if ariaDescribedby %}aria-describedby="{{ ariaDescribedby }}"{% endif %}
  data-component="Input"
>
{%- endset -%}
{%- set clearControl %}
<span class="input_clearable{{ ' is-filled' if isFilled else '' }}{{ (' ' + wrapperClass) if wrapperClass and not prefix and not suffix else '' }}">
  {{ control | safe }}
  {{ Button.button(
    variant='text',
    color='muted',
    iconOnly=true,
    iconBefore='close',
    ripple=false,
    ariaLabel='입력 지우기',
    hidden=not isFilled,
    className='input_clear'
  ) }}
</span>
{%- endset -%}
{%- set resolvedControl = clearControl if clearable else control -%}
{% if prefix or suffix %}
<div class="input_group{{ (' ' + wrapperClass) if wrapperClass else '' }}" data-component="InputGroup">
  {% if prefix %}<span class="input_group-addon" aria-hidden="true">{{ prefix | safe }}</span>{% endif %}
  {{ resolvedControl | safe }}
  {% if suffix %}<span class="input_group-addon">{{ suffix | safe }}</span>{% endif %}
</div>
{% else %}
{{ resolvedControl | safe }}
{% endif %}
{% endmacro %}

{% macro inputField(
  id = '',
  labelId = '',
  label = '',
  ariaLabel = '',
  control = '',
  hint = '',
  errorMessage = '',
  successMessage = '',
  required = false,
  fit = false,
  className = ''
) %}
{%- set content = caller() if caller else control -%}
<div class="form_field{{ ' form_field_fit' if fit else '' }}{{ (' ' + className) if className else '' }}">
  {% if label %}
    <label class="form_field-label"{% if labelId %} id="{{ labelId }}"{% endif %}{% if id %} for="{{ id }}"{% endif %}>
      {{ label }}
      {% if required %}<span class="form_field-required"><span aria-hidden="true">*</span><span class="form_field-required-text">필수 항목</span></span>{% endif %}
    </label>
  {% elif ariaLabel %}
    <label class="input_group-label_hidden" for="{{ id }}">{{ ariaLabel }}</label>
  {% endif %}
  {{ content | safe }}
  {% if errorMessage %}
    <p class="form_field-error"{% if id %} id="{{ id }}-error"{% endif %} role="alert">{{ errorMessage }}</p>
  {% elif successMessage %}
    <p class="form_field-success"{% if id %} id="{{ id }}-success"{% endif %} role="status">{{ successMessage }}</p>
  {% elif hint %}
    <p class="form_field-hint">{{ hint }}</p>
  {% endif %}
</div>
{% endmacro %}

{% macro inputGroup(prefix='', suffix='', className='', ariaLabelledby='') %}
{%- set content = caller() if caller else '' -%}
<div class="input_group{{ (' ' + className) if className else '' }}" data-component="InputGroup"{% if ariaLabelledby %} role="group" aria-labelledby="{{ ariaLabelledby }}"{% endif %}>
  {% if prefix %}<span class="input_group-addon" aria-hidden="true">{{ prefix | safe }}</span>{% endif %}
  {{ content | safe }}
  {% if suffix %}<span class="input_group-addon">{{ suffix | safe }}</span>{% endif %}
</div>
{% endmacro %}

{% macro inputCollection(variant='split', ariaLabelledby='', className='') %}
{%- set content = caller() if caller else '' -%}
{%- set resolvedVariant = variant if variant in ['split', 'otp'] else 'split' -%}
<div class="input_{{ resolvedVariant }}{{ (' ' + className) if className else '' }}" role="group"{% if ariaLabelledby %} aria-labelledby="{{ ariaLabelledby }}"{% endif %}>
  {{ content | safe }}
</div>
{% endmacro %}

{# include 시 기본 데모 (from import 시에는 실행되지 않음) #}
{% set demoInput %}{{ input(id='input-example', placeholder='이름을 입력하세요', clearable=true) }}{% endset %}
{{ inputField(id='input-example', label='이름', control=demoInput, hint='2~20자 이내로 입력해 주세요.') }}
