{# Checkbox 원본 구현: 체크박스·그룹·폼 필드를 macro 조합으로 구성합니다. #}

{% macro checkbox(
  id = '',
  name = '',
  value = '',
  label = '',
  checked = false,
  disabled = false,
  indeterminate = false,
  labelEnd = false,
  button = false,
  ripple = true,
  ariaLabel = '',
  ariaLabelledby = '',
  ariaDescribedby = '',
  className = ''
) %}
{%- set content = caller() if caller else label -%}
{%- set standalone = not content -%}
{%- set input -%}
<input
  {% if id %}id="{{ id }}"{% endif %}
  {% if name %}name="{{ name }}"{% endif %}
  {% if value %}value="{{ value }}"{% endif %}
  type="checkbox"
  class="checkbox_input"
  {% if checked %}checked{% endif %}
  {% if disabled %}disabled{% endif %}
  {% if indeterminate %}data-indeterminate="true" aria-checked="mixed"{% endif %}
  {% if ariaLabel %}aria-label="{{ ariaLabel }}"{% endif %}
  {% if ariaLabelledby %}aria-labelledby="{{ ariaLabelledby }}"{% endif %}
  {% if ariaDescribedby %}aria-describedby="{{ ariaDescribedby }}"{% endif %}
  data-component="Checkbox"
>
{%- endset -%}
{%- if standalone -%}
<label class="checkbox_control{{ (' ' + className) if className else '' }}" data-ripple="{{ 'true' if ripple else 'false' }}">
  {{ input | safe }}
  <span class="checkbox_box" aria-hidden="true"></span>
</label>
{%- elif button -%}
<label class="checkbox checkbox_button{{ (' ' + className) if className else '' }}" data-ripple="{{ 'true' if ripple else 'false' }}">
  {{ input | safe }}
  <span class="checkbox_label">{{ content | safe }}</span>
</label>
{%- else -%}
<div class="checkbox{{ ' checkbox_label-end' if labelEnd else '' }}{{ (' ' + className) if className else '' }}" data-ripple="{{ 'true' if ripple else 'false' }}">
  {% if labelEnd %}<label class="checkbox_label"{% if id %} for="{{ id }}"{% endif %}>{{ content | safe }}</label>{% endif %}
  <span class="checkbox_control">
    {{ input | safe }}
    <span class="checkbox_box" aria-hidden="true"></span>
  </span>
  {% if not labelEnd %}<label class="checkbox_label"{% if id %} for="{{ id }}"{% endif %}>{{ content | safe }}</label>{% endif %}
</div>
{%- endif -%}
{% endmacro %}

{% macro checkboxGroup(
  legend = '',
  horizontal = false,
  block = false,
  ariaLabelledby = '',
  className = '',
  style = ''
) %}
<fieldset
  class="checkbox_group{{ ' checkbox_group_horizontal' if horizontal else '' }}{{ ' checkbox_group_block' if block else '' }}{{ (' ' + className) if className else '' }}"
  {% if ariaLabelledby %}aria-labelledby="{{ ariaLabelledby }}"{% endif %}
  {% if style %}style="{{ style }}"{% endif %}
>
  {% if legend %}<legend class="checkbox_group-legend">{{ legend }}</legend>{% endif %}
  {% if caller %}{{ caller() | safe }}{% endif %}
</fieldset>
{% endmacro %}

{% macro checkboxField(
  label = '',
  labelId = '',
  hint = '',
  errorMessage = '',
  required = false,
  className = ''
) %}
<div class="form_field{{ (' ' + className) if className else '' }}">
  {% if label %}
    <span class="form_field-label"{% if labelId %} id="{{ labelId }}"{% endif %}>
      {{ label }}
      {% if required %}<span class="form_field-required"><span aria-hidden="true">*</span><span class="form_field-required-text">필수 항목</span></span>{% endif %}
    </span>
  {% endif %}
  {% if caller %}{{ caller() | safe }}{% endif %}
  {% if errorMessage %}
    <p class="form_field-error" role="alert">{{ errorMessage }}</p>
  {% elif hint %}
    <p class="form_field-hint">{{ hint }}</p>
  {% endif %}
</div>
{% endmacro %}

