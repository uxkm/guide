{# Select 원본 구현: 선택 옵션과 필드 상태를 Select 계열 macro로 구성합니다. #}

{% macro select(
  id = '',
  name = '',
  options = false,
  value = '',
  placeholder = '',
  size = 'md',
  nativeSize = '',
  multiple = false,
  disabled = false,
  required = false,
  error = false,
  fit = false,
  ariaLabel = '',
  ariaDescribedby = '',
  className = ''
) %}
{%- set content = caller() if caller else '' -%}
{%- set classes =
  'input'
  + (' input_sm' if size == 'sm' else '')
  + (' input_lg' if size == 'lg' else '')
  + (' input_fit' if fit else '')
  + (' is-error' if error else '')
  + ((' ' + className) if className else '')
-%}
<select
  {% if id %}id="{{ id }}"{% endif %}
  {% if name %}name="{{ name }}"{% endif %}
  class="{{ classes }}"
  {% if multiple %}multiple{% endif %}
  {% if nativeSize %}size="{{ nativeSize }}"{% endif %}
  {% if disabled %}disabled{% endif %}
  {% if required %}required aria-required="true"{% endif %}
  {% if error %}aria-invalid="true"{% endif %}
  {% if ariaLabel %}aria-label="{{ ariaLabel }}"{% endif %}
  {% if ariaDescribedby %}aria-describedby="{{ ariaDescribedby }}"{% endif %}
  data-component="Select"
>
  {% if placeholder %}<option value="" disabled{% if not value %} selected{% endif %}>{{ placeholder }}</option>{% endif %}
  {% if content %}
    {{ content | safe }}
  {% else %}
    {% for option in options %}
      {% if option.options %}
        <optgroup label="{{ option.label }}"{% if option.disabled %} disabled{% endif %}>
          {% for child in option.options %}
            <option value="{{ child.value }}"{% if child.value == value or child.selected or (multiple and value and child.value in value) %} selected{% endif %}{% if child.disabled %} disabled{% endif %}>{{ child.label }}</option>
          {% endfor %}
        </optgroup>
      {% else %}
        <option value="{{ option.value }}"{% if option.value == value or option.selected or (multiple and value and option.value in value) %} selected{% endif %}{% if option.disabled %} disabled{% endif %}>{{ option.label }}</option>
      {% endif %}
    {% endfor %}
  {% endif %}
</select>
{% endmacro %}

{% macro selectField(
  id = '',
  label = '',
  ariaLabel = '',
  control = '',
  hint = '',
  errorMessage = '',
  required = false,
  fit = false,
  className = ''
) %}
{%- set content = caller() if caller else control -%}
<div class="form_field{{ ' form_field_fit' if fit else '' }}{{ (' ' + className) if className else '' }}">
  {% if label %}
    <label class="form_field-label" for="{{ id }}">
      {{ label }}
      {% if required %}<span class="form_field-required"><span aria-hidden="true">*</span><span class="form_field-required-text">필수 항목</span></span>{% endif %}
    </label>
  {% elif ariaLabel %}
    <label class="input_group-label_hidden" for="{{ id }}">{{ ariaLabel }}</label>
  {% endif %}
  {{ content | safe }}
  {% if errorMessage %}
    <p id="{{ id }}-error" class="form_field-error" role="alert">{{ errorMessage }}</p>
  {% elif hint %}
    <p id="{{ id }}-hint" class="form_field-hint">{{ hint }}</p>
  {% endif %}
</div>
{% endmacro %}

{# include 시 기본 데모 (from import 시에는 실행되지 않음) #}
{% set demoOptions = [
  { value: 'seoul', label: '서울' },
  { value: 'busan', label: '부산' },
  { value: 'jeju', label: '제주' }
] %}
{% set demoSelect %}{{ select(id='select-region', options=demoOptions, placeholder='지역을 선택하세요', required=true, fit=true) }}{% endset %}
{{ selectField(id='select-region', label='지역', control=demoSelect, hint='거주 지역을 선택해 주세요.') }}
