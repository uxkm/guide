{# Snackbar 원본 구현: 메시지·액션·배치 영역을 macro로 구성합니다. #}
{% import "components/basic/Icon/icon.njk" as Icon %}
{% import "components/basic/Button/button.njk" as Button %}

{% macro snackbar(
  id = '',
  message = 'Snackbar',
  color = 'info',
  size = 'md',
  motion = 'fade',
  placement = 'bottom-center',
  duration = 0,
  role = 'status',
  closable = false,
  closeLabel = '알림 닫기',
  showIcon = true,
  round = false,
  icon = '',
  action = '',
  className = ''
) %}
{%- set content = caller() if caller else message -%}
{%- set resolvedColor = color if color in ['info', 'success', 'warning', 'danger'] else 'info' -%}
{%- set resolvedSize = size if size in ['sm', 'md', 'lg'] else 'md' -%}
{%- set resolvedMotion = motion if motion in ['fade', 'slide', 'none'] else 'fade' -%}
{%- set placements = ['top-start', 'top-center', 'top-end', 'middle-start', 'middle-end', 'bottom-start', 'bottom-center', 'bottom-end'] -%}
{%- set resolvedPlacement = placement if placement in placements else 'bottom-center' -%}
{%- set iconName = 'check-circle' if resolvedColor == 'success' else ('warning' if resolvedColor == 'warning' else ('x-circle' if resolvedColor == 'danger' else 'info')) -%}
{%- set classes =
  'snackbar ' + ('color_error' if resolvedColor == 'danger' else 'color_' + resolvedColor)
  + ((' snackbar_' + resolvedSize) if resolvedSize != 'md' else '')
  + (' snackbar_round' if round else '')
  + ' snackbar_motion-' + resolvedMotion
  + ' snackbar_placement-' + resolvedPlacement
  + ((' ' + className) if className else '')
-%}
<div
  {% if id %}id="{{ id }}"{% endif %}
  class="{{ classes }}"
  data-component="Snackbar"
  {% if duration %}data-snackbar-duration="{{ duration }}"{% endif %}
  role="{{ role }}"
  aria-live="{{ 'assertive' if role == 'alert' else 'polite' }}"
  aria-atomic="true"
  aria-relevant="additions text"
>
  {% if showIcon %}<span class="snackbar_icon-wrap" aria-hidden="true">{% if icon %}{{ icon | safe }}{% else %}{{ Icon.icon(name=iconName, className='snackbar_icon') }}{% endif %}</span>{% endif %}
  <div class="snackbar_message">{{ content | safe }}</div>
  {% if action %}<div class="snackbar_action">{{ action | safe }}</div>{% endif %}
  {% if closable %}
    {{ Button.button(
      variant='ghost',
      color='',
      iconOnly=true,
      iconBefore='close',
      ariaLabel=closeLabel,
      className='snackbar_close',
      dataAttributes={ 'data-snackbar-close': true }
    ) }}
  {% endif %}
</div>
{% endmacro %}

{% macro snackbarRegion(placement = 'bottom-center', label = '', className = '') %}
{%- set placements = ['top-start', 'top-center', 'top-end', 'middle-start', 'middle-end', 'bottom-start', 'bottom-center', 'bottom-end'] -%}
{%- set resolvedPlacement = placement if placement in placements else 'bottom-center' -%}
<div class="snackbar_region snackbar_region-{{ resolvedPlacement }}{{ (' ' + className) if className else '' }}"{% if label %} aria-label="{{ label }}"{% endif %}>
  {% if caller %}{{ caller() | safe }}{% endif %}
</div>
{% endmacro %}

{# include 시 기본 데모 (from import 시에는 실행되지 않음) #}
{{ snackbar(message='저장되었습니다.', color='success', motion='none') }}
