{# Spin 원본 구현: 단독 로더와 콘텐츠 오버레이를 호출형 macro로 구성합니다. #}

{% macro spinIndicator(className='') %}
<span class="spin_indicator{{ (' ' + className) if className else '' }}" aria-hidden="true"></span>
{% endmacro %}

{% macro spin(
  size='md',
  tip='',
  color='primary',
  inline=false,
  block=false,
  overlay=false,
  ariaLabel='로딩 중',
  className=''
) %}
{%- set content = caller() if caller else '' -%}
{%- set resolvedSize = size if size in ['sm', 'md', 'lg'] else 'md' -%}
{%- set resolvedColor = color if color in ['primary', 'success', 'warning', 'danger'] else 'primary' -%}
<div
  class="spin color_{{ resolvedColor }}{% if resolvedSize != 'md' %} spin_{{ resolvedSize }}{% endif %}{% if inline %} spin_inline{% endif %}{% if block %} spin_block{% endif %}{% if overlay %} spin_overlay{% endif %}{{ (' ' + className) if className else '' }}"
  data-component="Spin"
  role="status"
  aria-live="polite"
  aria-busy="true"
  aria-label="{{ ariaLabel }}"
>
  {{ spinIndicator() }}
  {% if tip %}<p class="spin_tip">{{ tip }}</p>{% endif %}
  {% if content %}{{ content | safe }}{% endif %}
</div>
{% endmacro %}

{% macro spinWrap(
  loading=false,
  block=false,
  blur=false,
  tip='',
  color='primary',
  size='md',
  ariaLabel='로딩 중',
  className=''
) %}
{%- set content = caller() if caller else '' -%}
<div
  class="spin_wrap{% if block %} spin_wrap-block{% endif %}{% if blur %} spin_wrap-blur{% endif %}{% if loading %} is-loading{% endif %}{{ (' ' + className) if className else '' }}"
  data-component="SpinWrap"
  data-loading="{{ 'true' if loading else 'false' }}"
  {% if loading %}aria-busy="true"{% endif %}
>
  <div class="spin_wrap-body">
    {{ content | safe }}
  </div>
  {% if loading %}
    {{ spin(size=size, tip=tip, color=color, overlay=true, ariaLabel=ariaLabel) }}
  {% endif %}
</div>
{% endmacro %}

{# include 시 기본 데모 (from import 시에는 실행되지 않음) #}
{{ spin() }}
