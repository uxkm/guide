{# Alert 원본 구현: 상태 메시지와 액션을 macro로 구성합니다. #}
{% import "components/basic/Icon/icon.njk" as Icon %}

{% macro alert(
  color = 'info',
  title = '',
  description = '',
  size = 'md',
  banner = false,
  closable = false,
  showIcon = true,
  role = 'alert',
  icon = '',
  actions = '',
  closeLabel = '알림 닫기',
  className = '',
  id = ''
) %}
{%- set content = caller() if caller else description -%}
{%- set resolvedColor = color if color in ['info', 'success', 'warning', 'danger'] else 'info' -%}
{%- set resolvedSize = size if size in ['sm', 'md', 'lg'] else 'md' -%}
{%- set iconName = 'check-circle' if resolvedColor == 'success' else ('warning' if resolvedColor == 'warning' else ('x-circle' if resolvedColor == 'danger' else 'info')) -%}
{%- set classes =
  'alert ' + ('color_error' if resolvedColor == 'danger' else 'color_' + resolvedColor)
  + ((' alert_' + resolvedSize) if resolvedSize != 'md' else '')
  + (' alert_banner' if banner else '')
  + ((' ' + className) if className else '')
-%}
<div{% if id %} id="{{ id }}"{% endif %} class="{{ classes }}" data-component="Alert" role="{{ role }}">
  {% if showIcon %}
    {% if icon %}{{ icon | safe }}{% else %}{{ Icon.icon(name=iconName, className='alert_icon') }}{% endif %}
  {% endif %}
  <div class="alert_body">
    {% if title %}<div class="alert_title">{{ title }}</div>{% endif %}
    {% if content %}<p class="alert_desc">{{ content | safe }}</p>{% endif %}
    {% if actions %}<div class="alert_actions">{{ actions | safe }}</div>{% endif %}
  </div>
  {% if closable %}
    <button type="button" class="alert_close" aria-label="{{ closeLabel }}">
      {{ Icon.icon(name='close') }}
    </button>
  {% endif %}
</div>
{% endmacro %}

{# include 시 기본 데모 (from import 시에는 실행되지 않음) #}
{{ alert(description='알림 메시지입니다.') }}
