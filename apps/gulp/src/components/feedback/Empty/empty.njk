{# Empty 원본 구현: 이미지·설명·푸터 영역을 호출형 macro로 구성합니다. #}
{% import "components/basic/Icon/icon.njk" as Icon %}

{% macro emptyImage(iconName='inbox', content='', className='') %}
{%- set image = caller() if caller else content -%}
<div class="empty_image{{ (' ' + className) if className else '' }}" data-slot="icon" aria-hidden="true">
  {% if image %}{{ image | safe }}{% else %}{{ Icon.icon(name=iconName) }}{% endif %}
</div>
{% endmacro %}

{% macro emptyDescription(description='', content='', className='') %}
{%- set body = caller() if caller else content -%}
<div class="empty_desc{{ (' ' + className) if className else '' }}" data-slot="description">
  {% if body %}{{ body | safe }}{% else %}<p>{{ description }}</p>{% endif %}
</div>
{% endmacro %}

{% macro emptyFooter(content='', className='') %}
{%- set footer = caller() if caller else content -%}
<div class="empty_footer{{ (' ' + className) if className else '' }}">
  {{ footer | safe }}
</div>
{% endmacro %}

{% macro empty(
  description='',
  descriptionSlot='',
  size='md',
  simple=false,
  block=false,
  iconName='inbox',
  iconSlot='',
  image='',
  footer='',
  className=''
) %}
{%- set customDescription = caller() if caller else descriptionSlot -%}
{%- set customIcon = iconSlot if iconSlot else image -%}
{%- set resolvedSize = size if size in ['sm', 'md', 'lg'] else 'md' -%}
<div
  class="empty{% if resolvedSize != 'md' %} empty_{{ resolvedSize }}{% endif %}{% if simple %} empty_simple{% endif %}{% if block %} empty_block{% endif %}{{ (' ' + className) if className else '' }}"
  data-component="Empty"
  role="status"
>
  {% if not simple %}
    {{ emptyImage(iconName=iconName, content=customIcon) }}
  {% endif %}
  {% if customDescription or description %}
    {{ emptyDescription(description=description, content=customDescription) }}
  {% endif %}
  {% if footer %}{{ emptyFooter(content=footer) }}{% endif %}
</div>
{% endmacro %}

{# include 시 기본 데모 (from import 시에는 실행되지 않음) #}
{{ empty(description='표시할 데이터가 없습니다.') }}
