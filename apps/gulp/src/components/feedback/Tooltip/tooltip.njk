{# Tooltip 원본 구현: 트리거와 말풍선을 호출형 macro로 조합합니다. #}
{% import "components/basic/Button/button.njk" as Button %}

{% macro tooltipTrigger(
  id='tooltip-basic',
  label='마우스 오버',
  content='',
  trigger='hover',
  open=false,
  variant='outline',
  color='primary',
  size='md',
  disabled=false,
  focusable=false,
  className=''
) %}
{% if content %}
<span
  class="tooltip_trigger{{ (' ' + className) if className else '' }}"
  aria-describedby="{{ id }}"
  {% if trigger == 'click' %}aria-expanded="{{ 'true' if open else 'false' }}"{% endif %}
  {% if focusable %}tabindex="0"{% endif %}
>
  {{ content | safe }}
</span>
{% else %}
{{ Button.button(
  variant=variant,
  color=color,
  size=size,
  label=label,
  disabled=disabled,
  expanded=(open if trigger == 'click' else ''),
  dataAttributes={'aria-describedby': id},
  className='tooltip_trigger' + ((' ' + className) if className else '')
) }}
{% endif %}
{% endmacro %}

{% macro tooltipBubble(id='tooltip-basic', content='', trigger='hover', noArrow=false, closable=false, closeLabel='닫기', open=false, className='') %}
{%- set body = caller() if caller else content -%}
<span
  class="tooltip_bubble{% if closable %} tooltip_bubble-closable{% endif %}{{ (' ' + className) if className else '' }}"
  id="{{ id }}"
  role="tooltip"
  {% if not open %}hidden{% endif %}
>
  {% if not noArrow %}<span class="tooltip_arrow" aria-hidden="true"></span>{% endif %}
  {% if closable %}
    {{ Button.button(
      variant='ghost',
      color='',
      iconOnly=true,
      iconBefore='close',
      ripple=false,
      ariaLabel=closeLabel,
      dataAttributes={'data-tooltip-close': true},
      className='tooltip_close tooltip_close-floating'
    ) }}
  {% endif %}
  {{ body | safe }}
</span>
{% endmacro %}

{% macro tooltip(
  id='tooltip-basic',
  content='',
  triggerLabel='마우스 오버',
  triggerContent='',
  trigger='hover',
  triggerVariant='outline',
  triggerColor='primary',
  triggerSize='md',
  triggerFocusable=false,
  placement='',
  size='md',
  offset='md',
  offsetTop='',
  offsetRight='',
  offsetBottom='',
  offsetLeft='',
  inverse=false,
  noArrow=false,
  arrowAnchor='content',
  panelAlign='center',
  arrowTargetAlign='center',
  closable=false,
  disabled=false,
  open=false,
  closeLabel='닫기',
  className=''
) %}
{%- set body = caller() if caller else (content if content else '짧은 도움말 텍스트입니다.') -%}
{%- set resolvedSize = size if size in ['sm', 'md', 'lg'] else 'md' -%}
{%- set resolvedPlacement = placement if placement in ['', 'top', 'top-start', 'top-end', 'left', 'right', 'start', 'end'] else '' -%}
{%- set resolvedTrigger = trigger if trigger in ['hover', 'click'] else 'hover' -%}
{%- set showClose = closable or resolvedTrigger == 'click' -%}
<span
  class="tooltip{% if resolvedSize != 'md' %} tooltip_{{ resolvedSize }}{% endif %}{% if resolvedPlacement %} tooltip_placement-{{ resolvedPlacement }}{% endif %}{% if offset and offset != 'md' %} tooltip_offset-{{ offset }}{% endif %}{% if offsetTop and offsetTop != 'md' %} tooltip_offset-top-{{ offsetTop }}{% endif %}{% if offsetRight and offsetRight != 'md' %} tooltip_offset-right-{{ offsetRight }}{% endif %}{% if offsetBottom and offsetBottom != 'md' %} tooltip_offset-bottom-{{ offsetBottom }}{% endif %}{% if offsetLeft and offsetLeft != 'md' %} tooltip_offset-left-{{ offsetLeft }}{% endif %}{% if inverse %} tooltip_inverse{% endif %}{% if noArrow %} tooltip_no-arrow{% endif %}{% if arrowAnchor != 'content' %} tooltip_arrow-anchor-{{ arrowAnchor }}{% endif %}{% if panelAlign != 'center' %} tooltip_panel-align-{{ panelAlign }}{% endif %}{% if open %} is-open{% endif %}{% if disabled %} is-disabled{% endif %}{{ (' ' + className) if className else '' }}"
  data-component="Tooltip"
  data-tooltip
  {% if resolvedTrigger == 'click' %}data-tooltip-trigger="click"{% endif %}
  {% if arrowTargetAlign != 'center' %}data-arrow-target-align="{{ arrowTargetAlign }}"{% endif %}
>
  {{ tooltipTrigger(
    id=id,
    label=triggerLabel,
    content=triggerContent,
    trigger=resolvedTrigger,
    open=open,
    variant=triggerVariant,
    color=triggerColor,
    size=triggerSize,
    disabled=disabled,
    focusable=triggerFocusable
  ) }}
  {{ tooltipBubble(
    id=id,
    content=body,
    trigger=resolvedTrigger,
    noArrow=noArrow,
    closable=showClose,
    closeLabel=closeLabel,
    open=open
  ) }}
</span>
{% endmacro %}

{# include 시 기본 데모 (from import 시에는 실행되지 않음) #}
{% call tooltip() %}짧은 도움말 텍스트입니다.{% endcall %}
