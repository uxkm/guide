# 로컬 개발: Guidebook Storybook 링크는 자동으로 http://localhost:6006/ 을 사용합니다.
# 배포 빌드: VITE_STORYBOOK_URL을 운영 Storybook 주소로 설정합니다.
# 개발 모드 페이지 생성(--mode=development)에서는 canonical·OG·파비콘을
# VITE_DEV_SITE_URL(기본 http://localhost:6107/)과 로컬 /images 자산으로 출력합니다.

VITE_SITE_URL=https://guide.uxkm.io/
VITE_STORYBOOK_URL=https://guide.uxkm.io/storybook/
VITE_ASSET_BASE=https://guide.uxkm.io/
VITE_SOCIAL_IMAGE_URL=https://uxkm.io/_assets/images/_common/og_image.png
