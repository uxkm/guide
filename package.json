{
  "name": "uxkm-framework-components",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm build:docs",
    "build:docs": "pnpm build:guidebook && pnpm build:storybook && node scripts/collect-docs.mjs",
    "dev": "node scripts/dev-all.mjs --docs-only",
    "dev:dashboard": "node scripts/dev.mjs",
    "dev:html": "pnpm build:shared && pnpm --filter @uxkm/html dev",
    "dev:gulp": "pnpm build:shared && pnpm --filter @uxkm/gulp dev",
    "dev:vue": "pnpm build:shared && pnpm --filter @uxkm/vue dev",
    "dev:react": "pnpm build:shared && pnpm --filter @uxkm/react dev",
    "dev:nuxt": "pnpm build:shared && pnpm --filter @uxkm/nuxt dev",
    "dev:next": "pnpm build:shared && pnpm --filter @uxkm/next dev",
    "dev:storybook": "pnpm storybook",
    "dev:guidebook": "pnpm build:shared && pnpm --filter @uxkm/guidebook dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build:shared": "pnpm build:styles && pnpm build:assets",
    "storybook": "pnpm build:shared && pnpm --filter @uxkm/storybook storybook",
    "build:guidebook": "pnpm --filter @uxkm/guidebook build",
    "build:storybook": "pnpm build:shared && pnpm --filter @uxkm/storybook build-storybook",
    "deploy": "pnpm build && node scripts/deploy-main.mjs all",
    "deploy:guidebook": "pnpm build:guidebook && node scripts/deploy-main.mjs guidebook",
    "deploy:storybook": "pnpm build:storybook && node scripts/deploy-main.mjs storybook",
    "check:workspace": "pnpm --recursive list --depth -1",
    "validate:structure": "node scripts/validate-components.mjs"
  },
  "devDependencies": {
    "sass": "^1.102.0"
  }
}
